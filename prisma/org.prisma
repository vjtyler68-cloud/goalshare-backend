// Organizations — a School / Sales / Gym org with one admin (trainer for gym)
// and members (trainees). Cross-device via the backend so an admin can see
// their roster. Field-level visibility is enforced app-side by a hardcoded
// whitelist; this layer just holds orgs + memberships.
model Organization {
    id                 String   @id @default(auto()) @map("_id") @db.ObjectId
    name               String
    orgType            String // 'school' | 'salesOrg' | 'gym'
    inviteCode         String   @unique
    adminUserId        String   @db.ObjectId
    additionalAdminIds String[] @db.ObjectId

    // Optional per-org "Territory Map" (a data map grid) — e.g. an ArcGIS Field
    // Maps deep link. Only members of an org that has one ever see it, so it can
    // be scoped to a single org (Cowboys). Empty for every other org.
    mapUrl   String?
    mapLabel String?

    // Optional per-org appointment scheduler — a booking widget URL (e.g. a
    // LeadConnector/GoHighLevel booking link) opened in-app. Same per-org scoping
    // as the map: only members of an org that has one see the scheduler.
    bookingUrl   String?
    bookingLabel String?

    // Per-org module opt-in: the shared Task Hub is OFF by default, so it only
    // appears in orgs whose admin explicitly turns it on. Nullable so existing
    // org documents (created before this field) read cleanly as "off".
    taskHubEnabled Boolean? @default(false)
    // Sales Ranch (canvassing) team access. Nullable/off by default so only the
    // admin can use it until they open it to the team.
    canvassEnabled Boolean? @default(false)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("organization")
}

// A post inside an org's private Team HQ. kind='announcement' (admin-only) or
// kind='feed' (any member). Only members of the org ever see these.
model OrgPost {
    id           String   @id @default(auto()) @map("_id") @db.ObjectId
    orgId        String   @db.ObjectId
    authorId     String   @db.ObjectId
    authorName   String   @default("")
    authorAvatar String   @default("")
    kind         String // 'announcement' | 'feed'
    text         String
    likes        String[] @db.ObjectId // userIds who reacted

    createdAt DateTime @default(now())

    @@map("orgpost")
}

// A shared team goal/target. Metric goals auto-sum from members' reported
// numbers (metricKey, e.g. 'leads.count'); 'manual' goals use manualProgress.
model OrgGoal {
    id             String @id @default(auto()) @map("_id") @db.ObjectId
    orgId          String @db.ObjectId
    title          String
    target         Int    @default(0)
    metricKey      String @default("manual") // 'leads.count' | 'rpm.goal_completed' | 'manual'
    manualProgress Int    @default(0)
    createdBy      String @db.ObjectId

    createdAt DateTime @default(now())

    @@map("orggoal")
}

// A project/initiative that groups tasks inside an org's Task Hub. Members only.
model OrgProject {
    id        String   @id @default(auto()) @map("_id") @db.ObjectId
    orgId     String   @db.ObjectId
    name      String
    color     String   @default("")
    createdBy String   @db.ObjectId
    createdAt DateTime @default(now())

    @@map("orgproject")
}

// A shared, assignable task inside an org's Task Hub — the backbone of the
// capture → organize → prioritize → schedule → assign → follow-up → review →
// report workflow. Only members of the org ever see or edit these.
model OrgTask {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    orgId String @db.ObjectId

    title String
    notes String @default("")

    status   String @default("todo") // todo | in_progress | waiting | approval | done
    priority String @default("medium") // low | medium | high | urgent

    dueAt      DateTime?
    followUpAt DateTime?
    waitingOn  String    @default("") // who/what this is waiting on

    assigneeId   String? @db.ObjectId // null = unassigned
    assigneeName String  @default("")

    projectId   String? @db.ObjectId
    dependsOnId String? @db.ObjectId // blocked until that task is done
    meetingId   String? @db.ObjectId // action item that came out of a meeting

    recurRule String    @default("none") // none | daily | weekly | monthly | quarterly
    recurEnd  DateTime?

    createdBy     String @db.ObjectId
    createdByName String @default("")

    completedAt DateTime?
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt

    @@map("orgtask")
}

// A meeting inside an org's Task Hub — a title, time, agenda, and notes.
// Action items are OrgTasks that carry this meeting's id (meetingId).
model OrgMeeting {
    id            String    @id @default(auto()) @map("_id") @db.ObjectId
    orgId         String    @db.ObjectId
    title         String
    startAt       DateTime?
    agenda        String    @default("") // agenda (can be multi-line)
    notes         String    @default("") // minutes / decisions
    createdBy     String    @db.ObjectId
    createdByName String    @default("")
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt

    @@map("orgmeeting")
}

model OrgMembership {
    id     String  @id @default(auto()) @map("_id") @db.ObjectId
    orgId  String  @db.ObjectId
    userId String  @db.ObjectId
    role   String // 'admin' | 'member'
    active Boolean @default(true) // soft-delete: false once a user leaves

    // Member-pushed, whitelist-scoped engagement summary (JSON string). Only the
    // fields allowed for this org type ever land here — never raw logs.
    summaryJson String?
    summaryAt   DateTime?

    joinedAt DateTime @default(now())

    @@map("orgmembership")
}
