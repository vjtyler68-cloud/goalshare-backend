// Solar Cowboys canvassing — door-to-door pins for a sales org. Access is
// enforced server-side by org membership (admin sees every pin in the org; a
// rep sees only their own) — the same model the Org module already uses.
model CanvassPin {
    id       String @id @default(auto()) @map("_id") @db.ObjectId
    orgId    String @db.ObjectId
    repId    String @db.ObjectId
    repName  String @default("")

    lat Float
    lng Float

    address String @default("")
    city    String @default("")
    state   String @default("")
    zip     String @default("")

    // Optional lead assignment: the admin can hand a door to a specific rep.
    // A rep sees pins they dropped (repId) OR ones assigned to them
    // (assignedRepId) — see listPins.
    assignedRepId   String? @db.ObjectId
    assignedRepName String?

    status        String // status code (APPT, NH, SLR, SALE, …)
    statusHistory String? // JSON: [{status, at, repId}]

    // Pipeline stage (Canvass-style funnel): lead | sale | approved | installed
    stage String @default("lead")

    // A pre-loaded prospect pin (every home in an area) vs a rep-dropped one.
    // Seeded pins are shared — visible to every rep on the team.
    seeded Boolean @default(false)

    homeownerName String?
    contactEmail  String?
    notes         String?
    notesLog      String? // JSON: [{repId, repName, text, at}]
    phone         String?

    // Deal / account fields — filled once a lead progresses toward a sale.
    actionItems       String? // JSON: {creditScore,equipment,pricing,siteAudit}
    systemSizeKw      Float?
    leaseRatePerMonth Float?
    leaseRatePerKwh   Float?

    // Cached home + owner enrichment (JSON) so a given door is only ever looked
    // up once against the paid data provider. enrichedAt marks that a lookup was
    // attempted (even if no record was found) so we never re-charge for it.
    enrichment String?
    enrichedAt DateTime?

    // Cached skip-trace contact (JSON: {name, phones[], emails[]}) — resident
    // name + phone/email. contactAt marks a lookup happened (one charge per door).
    contact   String?
    contactAt DateTime?

    visitCount  Int      @default(1)
    lastVisited DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("canvasspin")
}

// A drawn canvassing territory (a polygon area) an admin assigns to one or more
// reps. Reps see the areas assigned to them; the admin sees all. Doors that
// fall inside are computed client-side (point-in-polygon) so a rep can pull up
// every lead in their zone with the homeowner's info.
model CanvassTerritory {
    id    String @id @default(auto()) @map("_id") @db.ObjectId
    orgId String @db.ObjectId

    name  String @default("Territory")
    color String @default("#F59E0B")

    // JSON: [{ "lat": n, "lng": n }, ...] — the polygon boundary (>= 3 points).
    points String

    // Parallel arrays of the reps this area is assigned to (multi-assign).
    assignedRepIds   String[]
    assignedRepNames String[]

    createdBy String   @db.ObjectId
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("canvassterritory")
}
