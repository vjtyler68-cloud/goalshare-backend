// Solar Cowboys canvassing — door-to-door pins for a sales org. Access is
// enforced server-side by org membership (admin sees every pin in the org; a
// rep sees only their own) — the same model the Org module already uses.
model CanvassPin {
    id       String @id @default(auto()) @map("_id") @db.ObjectId
    orgId    String @db.ObjectId
    repId    String @db.ObjectId
    repName  String @default("")

    lat Float
    lng Float

    address String @default("")
    city    String @default("")
    state   String @default("")
    zip     String @default("")

    // Optional lead assignment: the admin can hand a door to a specific rep.
    // A rep sees pins they dropped (repId) OR ones assigned to them
    // (assignedRepId) — see listPins.
    assignedRepId   String? @db.ObjectId
    assignedRepName String?

    status        String // status code (APPT, NH, SLR, SALE, …)
    statusHistory String? // JSON: [{status, at, repId}]

    homeownerName String?
    notes         String?
    phone         String?

    visitCount  Int      @default(1)
    lastVisited DateTime @default(now())

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("canvasspin")
}
